<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Cookies, resume queue and saved media under the chosen SAF tree are all
         app-private; copying them to another device would leak login state. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
